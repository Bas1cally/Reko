# ===========================================
# Tennis Value-Betting Bot - Konfiguration
# Diese Datei nach .env kopieren und ausfuellen.
# .env ist in .gitignore und wird NICHT committed.
# ===========================================

# The Odds API (https://the-odds-api.com) - Quoten & Matchups
THE_ODDS_API_KEY=

# Telegram Bot (von @BotFather) + Ziel-Chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude / Anthropic API - News-/Kontext-Layer (Kern-Edge)
ANTHROPIC_API_KEY=
# Modell-ID fuer den News-Layer
ANTHROPIC_MODEL=claude-opus-4-8

# News-Beschaffung (NewsAPI.org). Optional - ohne Key wird News-Layer uebersprungen.
NEWS_API_KEY=

# ----- Strategie-Parameter (optional, sonst Defaults) -----
# Minimaler Erwartungswert, ab dem eine Wette gemeldet wird (0.05 = 5%)
MIN_EV=0.05
# Maximale Quote, ueber der wir nichts melden (Sanity)
MAX_ODDS=8.0
# Bruchteil-Kelly (0.5 = Halb-Kelly, aggressiv)
KELLY_FRACTION=0.5
# Harte Obergrenze pro Wette als Anteil der Bankroll (0.05 = 5%)
MAX_STAKE_FRACTION=0.05
# Bankroll fuer EUR-Anzeige in der Nachricht (0 = nur Prozent anzeigen)
BANKROLL=0
# Maximaler News-Nudge auf die Modell-Wahrscheinlichkeit (0.08 = +/-8%)
MAX_NEWS_ADJUSTMENT=0.08
# Verwirf Bet, wenn |Modell-Prob - Sharp-Prob| groesser als dieser Wert ist
MAX_MODEL_MARKET_GAP=0.25
# Komma-Liste "scharfer" Buchmacher (faire Referenz)
SHARP_BOOKMAKERS=pinnacle
# News-Layer aktiv? (true/false)
ENABLE_NEWS=true
# Touren: atp, wta oder beide (Komma)
TOURS=atp,wta

# ----- Markt-bewusste Wahrscheinlichkeit & De-Vig -----
# Mischung Modell<->Sharp: p_final = BLEND*Modell + (1-BLEND)*Sharp
MODEL_MARKET_BLEND=0.5
# Extra-EV-Schwelle, wenn kein scharfer Buchmacher als Anker da ist
NO_SHARP_EV_PENALTY=0.03
# De-Vig-Methode: power (empfohlen) oder multiplicative
DEVIG_METHOD=power

# ----- Zuverlaessigkeits-Filter -----
MIN_PLAYER_MATCHES=20
MIN_SURFACE_MATCHES=5
# Mindestzahl weicher Buchmacher, die die Quote anbieten
MIN_BOOKS=2

# ----- Modell (Elo) - Werte aus 'python -m bot.tune' uebernehmen -----
ELO_K_NUMERATOR=250
ELO_K_EXPONENT=0.4
SURFACE_BLEND=0.6
ELO_USE_MOV=true

# ----- Tracking / CLV -----
ENABLE_TRACKING=true
# Fenster (Minuten vor Anpfiff), in dem die Closing-Quote erfasst wird
CLOSE_WINDOW_MIN=60

# ----- Benachrichtigungen / Betrieb -----
NOTIFY_SUMMARY=true
NOTIFY_ERRORS=true
# Warnen, wenn API-Restkontingent darunter faellt
MIN_API_QUOTA_WARN=50
LOG_LEVEL=INFO
