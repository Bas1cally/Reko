# ===========================================
# Tennis Value-Betting Bot - Konfiguration
# Diese Datei nach .env kopieren und ausfuellen.
# .env ist in .gitignore und wird NICHT committed.
# ===========================================

# The Odds API (https://the-odds-api.com) - Quoten & Matchups
THE_ODDS_API_KEY=

# Telegram Bot (von @BotFather) + Ziel-Chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude / Anthropic API - News-/Kontext-Layer (Kern-Edge)
ANTHROPIC_API_KEY=
# Modell-ID fuer den News-Layer
ANTHROPIC_MODEL=claude-opus-4-8

# News-Beschaffung (NewsAPI.org). Optional - ohne Key wird News-Layer uebersprungen.
NEWS_API_KEY=

# ----- Strategie-Parameter (optional, sonst Defaults) -----
# Minimaler Erwartungswert, ab dem eine Wette gemeldet wird (0.05 = 5%)
MIN_EV=0.05
# Maximale Quote, ueber der wir nichts melden (Sanity)
MAX_ODDS=8.0
# Bruchteil-Kelly (0.25 = Viertel-Kelly)
KELLY_FRACTION=0.25
# Maximaler News-Nudge auf die Modell-Wahrscheinlichkeit (0.08 = +/-8%)
MAX_NEWS_ADJUSTMENT=0.08
# Verwirf Bet, wenn |Modell-Prob - Sharp-Prob| groesser als dieser Wert ist
MAX_MODEL_MARKET_GAP=0.25
# Komma-Liste "scharfer" Buchmacher (faire Referenz)
SHARP_BOOKMAKERS=pinnacle
# News-Layer aktiv? (true/false)
ENABLE_NEWS=true
# Touren: atp, wta oder beide (Komma)
TOURS=atp,wta
